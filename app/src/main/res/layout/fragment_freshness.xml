<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1: Check Eyes"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgEyes"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="#E0E0E0"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/btnUploadEyes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Eyes" />

        <TextView
            android:id="@+id/txtResultEyes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waiting for image..."
            android:textColor="#757575" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#CCCCCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 2: Check Gills"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgGills"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="#E0E0E0"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/btnUploadGills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Gills" />

        <TextView
            android:id="@+id/txtResultGills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waiting for image..."
            android:textColor="#757575" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#CCCCCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINAL VERDICT"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtFinalResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Upload both images to check"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

    </LinearLayout>
</ScrollView>